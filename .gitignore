# Rust
/target
**/*.rs.bk

# Node (asset pipeline scripts)
node_modules/

# Cargo.lock is committed for binaries (smirk is a binary — keep it)
# If you ever publish engine crates as libraries, add their Cargo.lock here

# IntelliJ / RustRover
.idea
*.iws
*.iml
*.ipr

# VS Code
.vscode/

# Environment / secrets
.env
.env.local

# OS
.DS_Store
Thumbs.db

# Claude Code / AI config + local design notes & task lists (kept local)
