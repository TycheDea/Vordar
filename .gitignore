.claude/*
!.claude/skills/
/tasks/

# Runtime data — server SQLite character database (+ WAL/SHM sidecars)
/vordar.db
/vordar.db-shm
/vordar.db-wal
# Stray file created when a cmd-style "2>NUL" redirect runs in a POSIX shell
/NUL
