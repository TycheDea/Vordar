# Rust
/target
**/*.rs.bk

# Node (asset pipeline scripts)
node_modules/

# Python (pipeline scripts import shared modules)
__pycache__/

# Cargo.lock is committed for binaries (smirk is a binary — keep it)
# If you ever publish engine crates as libraries, add their Cargo.lock here

# IntelliJ / RustRover
.idea
*.iws
*.iml
*.ipr

# VS Code
.vscode/

# Environment / secrets
.env
.env.local

# OS
.DS_Store
Thumbs.db

# Claude Code / AI config + local design notes & task lists (kept local).
# Only Claude-produced audit/plan/rework reports (docs/reviews/) are versioned.
.claude/
.pi/
/tasks/

# Locally-installed DirectXTex binary used for manual DDS conversion; no
# workspace script invokes it, so it is not fetched or tracked here.
/smirk/texconv.exe

# Runtime data — server SQLite character database (+ WAL/SHM sidecars)
/vordar.db
/vordar.db-shm
/vordar.db-wal
# Stray file created when a cmd-style "2>NUL" redirect runs in a POSIX shell
/NUL
vordar-credentials.ron
