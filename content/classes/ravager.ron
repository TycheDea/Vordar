// Ravager — melee DPS, Physical (CHARACTER-SYSTEM.md): rage-trance duelist,
// dual-wielding fury that trades defense for relentless pressure.
// Authored ability order = action-bar slot order: 0 = LMB, 1 = Q, 2 = E.
// Cast times are 60 Hz tick multiples so a dash lands exactly on its hit test.
//
// Outfit: dark pauldrons, twin blades at the hands, and an ember-red rage
// sigil at the chest (rhymes with the wayfarer's calm cyan crystal). The
// right blade is the cast-swing shape.
(
    abilities: [
        // The bread-and-butter strike: fast, short, centered on the blades.
        (
            id: "rend",
            name: "Rend",
            cooldown_micros: 900000,
            anim: Some("1H_Melee_Attack_Chop"),
            anim_secs: Some(0.5),
            effect: Scheduled(
                telegraph_prefab: "telegraph",
                radius: 2.0,
                damage: 16,
                damage_type: Physical,
                cast_micros: 300000,
                max_range: 2.5,
            ),
        ),
        // The heavy hit: slower, wider, worth timing. (Numbers shared with the
        // phase4 e2e choreography — radius 4.0 / 2 s cast / 3 s cooldown.)
        (
            id: "cleave",
            name: "Cleave",
            cooldown_micros: 3000000,
            anim: Some("1H_Melee_Attack_Slice_Horizontal"),
            anim_secs: Some(1.0),
            effect: Scheduled(
                telegraph_prefab: "telegraph",
                radius: 4.0,
                damage: 30,
                damage_type: Physical,
                cast_micros: 2000000,
                max_range: 8.0,
            ),
        ),
        // The gap-closer: dash to the point, blades out on arrival.
        (
            id: "onslaught",
            name: "Onslaught",
            cooldown_micros: 8000000,
            anim: Some("2H_Melee_Attack_Spinning"),
            anim_secs: Some(0.8),
            effect: Leap(
                telegraph_prefab: "telegraph",
                radius: 3.0,
                damage: 24,
                damage_type: Physical,
                cast_micros: 400000,
                max_range: 12.0,
            ),
        ),
    ],
    outfit: [
        (shape: RoundedBox(corner_radius: 0.08), offset: (0.34, 0.42, 0.0),  scale: (0.20, 0.14, 0.24), color: (0.28, 0.07, 0.07)),
        (shape: RoundedBox(corner_radius: 0.08), offset: (-0.34, 0.42, 0.0), scale: (0.20, 0.14, 0.24), color: (0.28, 0.07, 0.07)),
        (shape: Cube,    offset: (0.42, 0.10, 0.30),  scale: (0.06, 0.38, 0.10), color: (0.62, 0.60, 0.58)),
        (shape: Cube,    offset: (-0.42, 0.10, 0.30), scale: (0.06, 0.38, 0.10), color: (0.62, 0.60, 0.58)),
        (shape: Diamond, offset: (0.0, 0.42, 0.24),   scale: (0.10, 0.16, 0.10), color: (1.0, 0.25, 0.15)),
    ],
    pose: (
        bob_amplitude: 0.035,
        bob_speed: 2.2,
        swing_index: Some(2),
        swing_arc: (0.12, 0.30, 0.40),
    ),
    // Skinned-race tint (the ravager): an ember-red rage cast over the mesh,
    // rhyming with the chest sigil. Ignored by SDF races.
    tint: Some((1.0, 0.55, 0.48)),
)
