// Zone topology (Phase 7). The server runs one headless App per zone; the
// zone order here fixes the port assignment (base port + index), so "start"
// must come first — it's where fresh characters spawn and clients connect.
//
// Portal arrival points must sit clear of every portal in the destination
// (validate_zones enforces radius + 2.0) so arriving can't bounce back.
(
    zones: [
        (
            name: "start",
            chapter: Some("chapter03"),
            portals: [
                (pos: (22.0, 0.0, 0.0), radius: 2.0, target_zone: "east", target_pos: (-16.0, 0.0, 0.0)),
            ],
            // Theme pass (VQ-A5): G1 overcast HDRI (the shipped look, see
            // docs/reviews/town/g1-lighting-2026-07-30.md), depth fog,
            // cracked-earth PBR ground, ruined chapel stonework and cypress
            // silhouettes among the rocks. Props sit on the ground plane
            // (y = -0.5), clear of spawn and portals.
            visuals: (
                env: Some("content/textures/env/castilian_plateau_overcast_2k.hdr"),
                // Soft, near-shadowless overcast key — the HDRI has no real
                // sun disc, so az/el are a synthetic direction, not a
                // measured one (see g1-lighting-2026-07-30.md).
                sun_azimuth_deg: Some(83.1),
                sun_elevation_deg: Some(60.0),
                sun_color: (1.0, 1.0, 1.0),
                sun_intensity: 0.25,
                ambient: 1.0,
                exposure: 0.5763153092807317,
                // Fog is the visible horizon (sky.wgsl blends to it at 0°
                // elevation); sampled from the HDRI's upper-sky mean
                // (elevation > 30°) rather than the horizon band, which
                // carries an amber cast the upper sky doesn't (see
                // g1-lighting-2026-07-30.md).
                fog_color: (0.32728323340415955, 0.3519519865512848, 0.4090961813926697),
                fog_density: 0.0055,
                // Height fog (VQ-A1): full density at ground level (y = -0.5),
                // thinning above so prop tops read clearer than the ground haze.
                fog_height: 0.0,
                fog_height_falloff: 0.12,
                ground: Some((
                    texture_dir: "content/textures/ground/cracked_earth",
                    tile: 7.0,
                    // Worn cobble (§3) over the paved corridor between the casa
                    // rows, everywhere else stays cracked earth. Rectangle
                    // snapped outward to the 3.125 m ground grid
                    // (400/(RESOLUTION-1)) so the material seam falls exactly
                    // on a grid line — no staircase, since quantization only
                    // bites diagonal or curved bounds.
                    regions: [
                        // Casa-row facades sit at z=+-9.2 (measured from
                        // footprints.ron door-facing edges), snapped outward to
                        // z=+-9.375; the rows bound the premise §4 plaza, so
                        // paving stops at the facade line rather than at the
                        // plaza's nominal r≈12. X spans the built row extent
                        // (casa_small_b/a/two_story/corner placements above,
                        // corner wings included via footprints.ron's composite
                        // AABB), snapped outward from [-19.35, 13.95].
                        (texture_dir: "content/textures/ground/worn_cobble", tile: 7.0, min: (-21.875, -9.375), max: (15.625, 9.375)),
                    ],
                )),
                props: [
                    // Rocalba town (tasks/town/p24-layout.md §4). Every kit
                    // placement here has a same-XZ collision spawn in
                    // chapter03/chapter.ron; move them together. Kit door
                    // facades face -Z at yaw 0 (yaw 90 -> W, 180 -> N,
                    // 270 -> E); yaws stay in {0, 90, 180, 270} because the
                    // collision boxes are axis-aligned.
                    // North row, fronts on the z=+9.5 facade line, doors south
                    // toward the plaza; party walls touch (0.6 m wall overlap).
                    (model: "content/models/props/casa_small_b/casa_small_b.gltf",     pos: (-12.2, -0.5, 13.2), scale: 1.0, yaw: 0.0),
                    (model: "content/models/props/casa_small_a/casa_small_a.gltf",     pos: (-6.4, -0.5, 13.5),  scale: 1.0, yaw: 0.0),
                    (model: "content/models/props/casa_two_story/casa_two_story.gltf", pos: (0.1, -0.5, 14.5),   scale: 1.0, yaw: 0.0),
                    // Corner house at the row's east end, wing toward the road mouth.
                    (model: "content/models/props/casa_corner/casa_corner.gltf",       pos: (6.6, -0.5, 12.5),   scale: 1.0, yaw: 0.0),
                    // South row, fronts on z=-9.5, doors north. The corner
                    // house holds the WEST end (wing at yaw 180 is locked to
                    // -X, so anywhere mid-row it would run into its west
                    // neighbor); its wing extends past the row end.
                    (model: "content/models/props/casa_corner/casa_corner.gltf",       pos: (-12.0, -0.5, -12.5), scale: 1.0, yaw: 180.0),
                    (model: "content/models/props/casa_small_a/casa_small_a.gltf",     pos: (-6.0, -0.5, -13.5),  scale: 1.0, yaw: 180.0),
                    (model: "content/models/props/casa_two_story/casa_two_story.gltf", pos: (0.5, -0.5, -14.5),   scale: 1.0, yaw: 180.0),
                    (model: "content/models/props/casa_small_b/casa_small_b.gltf",     pos: (6.8, -0.5, -13.2),   scale: 1.0, yaw: 180.0),
                    // Chapel anchoring the SW precinct, door east toward the town.
                    (model: "content/models/props/chapel/chapel.gltf",                 pos: (-30.0, -0.5, -29.0), scale: 1.0, yaw: 0.0),
                    // East gate astride the road: face runs along Z (yaw 90),
                    // 3.2 m opening on the portal corridor.
                    (model: "content/models/props/gate_arch/gate_arch.gltf",           pos: (15.0, -0.5, 0.0),    scale: 1.0, yaw: 90.0),
                    (model: "content/models/props/well_basin/well_basin.gltf",         pos: (0.0, -0.5, -4.6),    scale: 1.0, yaw: 0.0),
                    // Ruined town-wall fragments along x=15; the gap
                    // z in [3.2, 7.0] is the unfinished breach where the
                    // crucero shrine stands.
                    (model: "content/models/props/wall_segment/wall_segment.gltf",     pos: (15.0, -0.5, 9.0),    scale: 1.0, yaw: 90.0),
                    (model: "content/models/props/wall_segment/wall_segment.gltf",     pos: (15.0, -0.5, 13.5),   scale: 1.0, yaw: 90.0),
                    (model: "content/models/props/wall_segment/wall_segment.gltf",     pos: (15.0, -0.5, -5.5),   scale: 1.0, yaw: 90.0),
                    (model: "content/models/props/wall_segment/wall_segment.gltf",     pos: (15.0, -0.5, -10.0),  scale: 1.0, yaw: 90.0),
                    // Votive stands flanking the apse, inside the chapel nave.
                    // Held clear of the apse end wall (x=-38.00): stand
                    // half-depth is 0.59 m, so x=-37.0 leaves 0.41 m of air.
                    (model: "content/models/props/candelabra_shrine/candelabra_shrine.glb", pos: (-37.0, -0.5, -27.6), scale: 1.0, yaw: 0.0),
                    (model: "content/models/props/candelabra_shrine/candelabra_shrine.glb", pos: (-37.0, -0.5, -30.4), scale: 1.0, yaw: 180.0),
                    (model: "content/models/props/rock_09/rock_09_1k.gltf",           pos: (14.0, -0.5, -19.0), scale: 24.3, yaw: 40.0),
                    (model: "content/models/props/rock_07/rock_07_1k.gltf",           pos: (-24.0, -0.5, 13.0), scale: 5.9, yaw: 205.0),
                    (model: "content/models/props/rock_09/rock_09_1k.gltf",           pos: (-11.0, -0.5, 27.0), scale: 19.8, yaw: 118.0),
                    (model: "content/models/props/rock_07/rock_07_1k.gltf",           pos: (31.0, -0.5, 22.0),  scale: 4.9, yaw: 320.0),
                    // Gate shrine: crucero standing in the town wall's
                    // unfinished breach north of the gate. Scaled up so its
                    // silhouette reads as a monument, not a grave marker.
                    (model: "content/models/props/crucero/crucero.glb",               pos: (15.0, -0.5, 6.0), scale: 1.5, yaw: 200.0),
                    // Ruin fragments around the chapel precinct: the arch
                    // clears the chapel south wall by 1.1 m; the column sits
                    // clear of the east door approach.
                    (model: "content/models/props/chapel_arch/chapel_arch.glb",       pos: (-26.0, -0.5, -36.5), scale: 1.0,  yaw: 40.0),
                    (model: "content/models/props/broken_column/broken_column.glb",   pos: (-19.5, -0.5, -34.0), scale: 0.9,  yaw: 190.0),
                    // Collapse rubble outside the chapel's east (roofless)
                    // half, clear of the walls, the arch, the jamb and the
                    // door approach.
                    (model: "content/models/props/rock_07/rock_07_1k.gltf",           pos: (-25.5, -0.5, -24.1), scale: 5.9, yaw: 90.0),
                    (model: "content/models/props/rock_07/rock_07_1k.gltf",           pos: (-21.6, -0.5, -34.3), scale: 5.0, yaw: 0.0),
                    // Graveyard patch north of the chapel.
                    (model: "content/models/props/gravestone/gravestone.glb",         pos: (-31.0, -0.5, -21.2), scale: 0.72, yaw: 210.0),
                    (model: "content/models/props/gravestone/gravestone.glb",         pos: (-27.5, -0.5, -23.4), scale: 0.70, yaw: 45.0),
                    (model: "content/models/props/gravestone/gravestone.glb",         pos: (-35.0, -0.5, -22.6), scale: 0.75, yaw: 320.0),
                    (model: "content/models/props/cypress/cypress.glb",               pos: (-34.0, -0.5, -40.0), scale: 4.75, yaw: 300.0),
                    // Toppled column past the play-radius edge.
                    (model: "content/models/props/broken_column/broken_column.glb",   pos: (-58.0, -0.5, 14.0),  scale: 1.0,  yaw: 305.0),
                    // Cypress pairs — silhouettes at the field edges.
                    (model: "content/models/props/cypress/cypress.glb",               pos: (-48.0, -0.5, 42.0),  scale: 5.0,  yaw: 20.0),
                    (model: "content/models/props/cypress/cypress.glb",               pos: (-42.0, -0.5, 48.0),  scale: 4.25, yaw: 140.0),
                    (model: "content/models/props/cypress/cypress.glb",               pos: (30.0, -0.5, -52.0),  scale: 5.5,  yaw: 75.0),
                    (model: "content/models/props/cypress/cypress.glb",               pos: (36.0, -0.5, -46.0),  scale: 4.5,  yaw: 230.0),
                    // Dead olive stumps in the mid field.
                    (model: "content/models/props/olive_stump/olive_stump.glb",       pos: (-17.0, -0.5, 19.0),  scale: 1.2,  yaw: 85.0),
                    (model: "content/models/props/olive_stump/olive_stump.glb",       pos: (24.0, -0.5, -24.0),  scale: 1.0,  yaw: 300.0),
                    (model: "content/models/props/olive_stump/olive_stump.glb",       pos: (-8.0, -0.5, -30.0),  scale: 0.9,  yaw: 160.0),
                    // Horizon landmarks out in the hills.
                    (model: "content/models/props/rock_face_01/rock_face_01_1k.gltf", pos: (-95.0, -0.5, -70.0), scale: 4.0, yaw: 15.0),
                    (model: "content/models/props/rock_face_01/rock_face_01_1k.gltf", pos: (80.0, -0.5, 105.0),  scale: 3.2, yaw: 250.0),
                ],
            ),
        ),
        (
            name: "east",
            // No chapter (zero NPC spawns): same deferral as start — the
            // Emberwood town/camp content is not dressing.
            chapter: None,
            portals: [
                (pos: (-22.0, 0.0, 0.0), radius: 2.0, target_zone: "start", target_pos: (16.0, 0.0, 0.0)),
            ],
            // Emberwood Rest: a worn-cobble settlement square under the same
            // G1 overcast sky as start (D6 ruling: relight only — same
            // lighting constants, sparser dressing kept as authored). Props
            // sit on the ground plane (y = -0.5), clear of the portal
            // corridor on the west side.
            visuals: (
                env: Some("content/textures/env/castilian_plateau_overcast_2k.hdr"),
                sun_azimuth_deg: Some(83.1),
                sun_elevation_deg: Some(60.0),
                sun_color: (1.0, 1.0, 1.0),
                sun_intensity: 0.25,
                ambient: 1.0,
                exposure: 0.5763153092807317,
                // Fog matches start exactly (D6: same lighting constants,
                // not a re-measured per-zone tilt).
                fog_color: (0.32728323340415955, 0.3519519865512848, 0.4090961813926697),
                fog_density: 0.004,
                fog_height: 0.0,
                fog_height_falloff: 0.12,
                ground: Some((texture_dir: "content/textures/ground/worn_cobble", tile: 7.0)),
                props: [
                    // Shrine pair framing the square's centre.
                    (model: "content/models/props/candelabra_shrine/candelabra_shrine.glb", pos: (5.0, -0.5, -6.0), scale: 1.0, yaw: 205.0),
                    (model: "content/models/props/candelabra_shrine/candelabra_shrine.glb", pos: (8.0, -0.5, 6.0),  scale: 1.0, yaw: 30.0),
                    // Wayside crucero greeting arrivals at the west entrance.
                    (model: "content/models/props/crucero/crucero.glb",               pos: (-12.0, -0.5, 7.0), scale: 1.0, yaw: 100.0),
                    // Ruined gate fragment at the square's far corner.
                    (model: "content/models/props/chapel_arch/chapel_arch.glb",       pos: (27.0, -0.5, -13.0), scale: 1.0,  yaw: 250.0),
                    // Toppled colonnade remnants edging the plaza.
                    (model: "content/models/props/broken_column/broken_column.glb",   pos: (-3.0, -0.5, 14.0),  scale: 1.0,  yaw: 130.0),
                    (model: "content/models/props/broken_column/broken_column.glb",   pos: (15.0, -0.5, -17.0), scale: 0.85, yaw: 20.0),
                    // Sparse dead stumps past the cobbles.
                    (model: "content/models/props/olive_stump/olive_stump.glb",       pos: (-13.0, -0.5, 23.0), scale: 1.0,  yaw: 190.0),
                    (model: "content/models/props/olive_stump/olive_stump.glb",       pos: (21.0, -0.5, 21.0),  scale: 0.9,  yaw: 340.0),
                ],
            ),
        ),
    ],
)
