// Zone topology (Phase 7). The server runs one headless App per zone; the
// zone order here fixes the port assignment (base port + index), so "start"
// must come first — it's where fresh characters spawn and clients connect.
//
// Portal arrival points must sit clear of every portal in the destination
// (validate_zones enforces radius + 2.0) so arriving can't bounce back.
(
    zones: [
        (
            name: "start",
            // No chapter (zero NPC spawns): chapter content is the placeholder
            // town/camp prefab set the pre-content foundation stage defers.
            chapter: None,
            portals: [
                (pos: (22.0, 0.0, 0.0), radius: 2.0, target_zone: "east", target_pos: (-16.0, 0.0, 0.0)),
            ],
            // Theme pass (VQ-A5): dusk HDRI (the default env), depth fog,
            // cracked-earth PBR ground, ruined chapel stonework and cypress
            // silhouettes among the rocks. Props sit on the ground plane
            // (y = -0.5), clear of spawn and portals.
            visuals: (
                // Fog is the visible horizon (sky.wgsl blends to it at 0°
                // elevation), so it must hold the HDRI's horizon register:
                // measured band mean (3.40, 1.09, 0.42) linear — same amber
                // ratio here, at median-horizon magnitude so the anti-sun
                // side doesn't glow.
                fog_color: (2.0, 0.64, 0.25),
                fog_density: 0.0055,
                // Height fog (VQ-A1): full density at ground level (y = -0.5),
                // thinning above so prop tops read clearer than the ground haze.
                fog_height: 0.0,
                fog_height_falloff: 0.12,
                ground: Some((texture_dir: "content/textures/ground/cracked_earth", tile: 7.0)),
                props: [
                    // First Z-Image prop, near spawn for the feel-check.
                    (model: "content/models/props/candelabra_shrine/candelabra_shrine.glb", pos: (-4.0, -0.5, -5.0), scale: 1.0, yaw: 25.0),
                    (model: "content/models/props/rock_09/rock_09_1k.gltf",           pos: (14.0, -0.5, -19.0), scale: 3.0, yaw: 40.0),
                    (model: "content/models/props/rock_07/rock_07_1k.gltf",           pos: (-24.0, -0.5, 13.0), scale: 2.2, yaw: 205.0),
                    (model: "content/models/props/rock_09/rock_09_1k.gltf",           pos: (-11.0, -0.5, 27.0), scale: 1.6, yaw: 118.0),
                    (model: "content/models/props/rock_07/rock_07_1k.gltf",           pos: (31.0, -0.5, 22.0),  scale: 1.8, yaw: 320.0),
                    // Ruined chapel cluster — the mid-distance landmark southwest of spawn.
                    (model: "content/models/props/chapel_arch/chapel_arch.glb",       pos: (-26.0, -0.5, -34.0), scale: 1.0,  yaw: 40.0),
                    (model: "content/models/props/broken_column/broken_column.glb",   pos: (-20.0, -0.5, -29.0), scale: 0.9,  yaw: 190.0),
                    // Small grave-marker cluster within the chapel ruins.
                    (model: "content/models/props/gravestone/gravestone.glb",         pos: (-31.0, -0.5, -27.0), scale: 0.72, yaw: 210.0),
                    (model: "content/models/props/gravestone/gravestone.glb",         pos: (-28.5, -0.5, -24.5), scale: 0.70, yaw: 45.0),
                    (model: "content/models/props/gravestone/gravestone.glb",         pos: (-33.5, -0.5, -29.5), scale: 0.75, yaw: 320.0),
                    (model: "content/models/props/cypress/cypress.glb",               pos: (-34.0, -0.5, -40.0), scale: 0.95, yaw: 300.0),
                    // Toppled column past the play-radius edge.
                    (model: "content/models/props/broken_column/broken_column.glb",   pos: (-58.0, -0.5, 14.0),  scale: 1.0,  yaw: 305.0),
                    // Cypress pairs — dusk silhouettes at the field edges.
                    (model: "content/models/props/cypress/cypress.glb",               pos: (-48.0, -0.5, 42.0),  scale: 1.0,  yaw: 20.0),
                    (model: "content/models/props/cypress/cypress.glb",               pos: (-42.0, -0.5, 48.0),  scale: 0.85, yaw: 140.0),
                    (model: "content/models/props/cypress/cypress.glb",               pos: (30.0, -0.5, -52.0),  scale: 1.1,  yaw: 75.0),
                    (model: "content/models/props/cypress/cypress.glb",               pos: (36.0, -0.5, -46.0),  scale: 0.9,  yaw: 230.0),
                    // Dead olive stumps in the mid field.
                    (model: "content/models/props/olive_stump/olive_stump.glb",       pos: (-16.0, -0.5, 18.0),  scale: 1.2,  yaw: 85.0),
                    (model: "content/models/props/olive_stump/olive_stump.glb",       pos: (24.0, -0.5, -24.0),  scale: 1.0,  yaw: 300.0),
                    (model: "content/models/props/olive_stump/olive_stump.glb",       pos: (-8.0, -0.5, -30.0),  scale: 0.9,  yaw: 160.0),
                    // Horizon landmarks out in the hills.
                    (model: "content/models/props/rock_face_01/rock_face_01_1k.gltf", pos: (-95.0, -0.5, -70.0), scale: 4.0, yaw: 15.0),
                    (model: "content/models/props/rock_face_01/rock_face_01_1k.gltf", pos: (80.0, -0.5, 105.0),  scale: 3.2, yaw: 250.0),
                ],
            ),
        ),
        (
            name: "east",
            // No chapter (zero NPC spawns): same deferral as start — the
            // Emberwood town/camp content is not dressing.
            chapter: None,
            portals: [
                (pos: (-22.0, 0.0, 0.0), radius: 2.0, target_zone: "start", target_pos: (16.0, 0.0, 0.0)),
            ],
            // Emberwood Rest: a worn-cobble settlement square under the same
            // dusk sky — drier, warmer haze, sparser dressing than start.
            // Props sit on the ground plane (y = -0.5), clear of the portal
            // corridor on the west side.
            visuals: (
                // Fog is the visible horizon here too: same measured HDRI
                // band anchor as start ((3.40, 1.09, 0.42) linear), the amber
                // ratio warmed by the parked zone pair's channel tilt at
                // near-start magnitude so the seam still reads as one sky.
                fog_color: (2.3, 0.69, 0.22),
                fog_density: 0.004,
                fog_height: 0.0,
                fog_height_falloff: 0.12,
                ground: Some((texture_dir: "content/textures/ground/worn_cobble", tile: 7.0)),
                props: [
                    // Shrine pair framing the square's centre.
                    (model: "content/models/props/candelabra_shrine/candelabra_shrine.glb", pos: (5.0, -0.5, -6.0), scale: 1.0, yaw: 205.0),
                    (model: "content/models/props/candelabra_shrine/candelabra_shrine.glb", pos: (8.0, -0.5, 6.0),  scale: 1.0, yaw: 30.0),
                    // Ruined gate fragment at the square's far corner.
                    (model: "content/models/props/chapel_arch/chapel_arch.glb",       pos: (27.0, -0.5, -13.0), scale: 1.0,  yaw: 250.0),
                    // Toppled colonnade remnants edging the plaza.
                    (model: "content/models/props/broken_column/broken_column.glb",   pos: (-3.0, -0.5, 14.0),  scale: 1.0,  yaw: 130.0),
                    (model: "content/models/props/broken_column/broken_column.glb",   pos: (15.0, -0.5, -17.0), scale: 0.85, yaw: 20.0),
                    // Sparse dead stumps past the cobbles.
                    (model: "content/models/props/olive_stump/olive_stump.glb",       pos: (-13.0, -0.5, 23.0), scale: 1.0,  yaw: 190.0),
                    (model: "content/models/props/olive_stump/olive_stump.glb",       pos: (21.0, -0.5, 21.0),  scale: 0.9,  yaw: 340.0),
                ],
            ),
        ),
    ],
)
