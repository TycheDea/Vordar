// Player ("the wayfarer") — a Human wearing the human class's traveler
// outfit. The visual is composed client-side: race base body (content/races/
// human.ron) + class outfit (content/classes/human.ron) — no ShapeGroup is
// authored here. Sim components unchanged.
// Component names must match ComponentRegistry registrations.
(
    components: {
        "Transform":  (),
        "Velocity":   (),
        "Hitbox":     (shape: Aabb(half_extents: (0.5, 0.5, 0.5))),
        "Solid":      (),
        "Health":     (current: 100, max: 100),
        "Player":     (speed: 6.0),
        "Race":       (id: "human"),
        "Class":      (id: "human"),
    },
)
