// Kit-type XZ footprints, measured from the installed glTFs
// (content/models/props/<type>/). Frame: model frame = world frame at
// yaw 0 — x is width, z is depth; casa door facades face -Z, the chapel
// door end faces +X (nave runs along X). P2.5's layout lint asserts the
// chapter03 collision spawns against this data (tasks/town/p24-layout.md §5).
//
// size: outer wall/body XZ extent within the 2 m player band — what a
//   collision Aabb mirrors, and re-measured off the glTF by content_lint, so
//   it is a reading and never an arithmetic. NOTE: the plan §1 table lists
//   wall-centerline footprints and adding one wall thickness to those gives
//   numbers ~5 cm wide of the built mesh; the mesh wins.
// tolerance: how far the visual solid may exceed the collision box per axis
//   (decorative or approximated volume: quoins/eaves on casas, wall coping,
//   gate imposts, the round well basin vs its square box, the chapel apse
//   fan which the flat apse wall leaves uncollided).
// members: composite types spawn one collision piece per member, each
//   offset (one entry per instance — a member with two positions, like a
//   party of jambs, lists both) in this frame from the prop position. A type
//   with no members list is a single piece: one spawn under the type's own
//   name, at offset (0,0). Members carry no size of their own — the chapel
//   and gate ship as one mesh each, so there is no independent per-piece
//   measurement to check a member's collision box against; P2.5's lint
//   instead unions the placed pieces' actual hitboxes and checks THAT
//   against the type's own measured `size`, the same way a simple type's
//   single piece already is.
(
    types: {
        "casa_small_a": ( size: (6.55, 8.55), tolerance: 0.1 ),
        "casa_small_b": ( size: (6.2, 7.95), tolerance: 0.1 ),
        "casa_two_story": ( size: (7.55, 10.55), tolerance: 0.1 ),
        // Composite AABB spans x in [-3.3, 7.35] — centered on the main
        // block, wing to +X. Wing is rotated 90°: ridge along Z.
        "casa_corner": (
            size: (10.6, 6.55),
            tolerance: 0.1,
            members: [
                ( prefab: "casa_corner_main", offsets: [(0.0, 0.0)] ),
                ( prefab: "casa_corner_wing", offsets: [(4.8, -1.0)] ),
            ],
        ),
        // Body 4.0 x 0.6; the coping course overhangs to 4.1 x 0.8.
        "wall_segment": ( size: (4.0, 0.6), tolerance: 0.2 ),
        // Jamb faces 6.4 x 0.9; imposts/voussoirs overhang to 6.5 x 1.1.
        // Composite: two gate_jamb pieces flanking the 3.2 m opening plus
        // gate_head aloft over it (offsets in this frame, before the yaw 90
        // placement rotation — chapter.ron's world offsets are (0,+-2.4)/(0,0)).
        "gate_arch": (
            size: (6.4, 0.9),
            tolerance: 0.1,
            members: [
                ( prefab: "gate_jamb", offsets: [(2.4, 0.0), (-2.4, 0.0)] ),
                ( prefab: "gate_head", offsets: [(0.0, 0.0)] ),
            ],
        ),
        // Asymmetric about the origin: door end at x = +8.6, apse fan out to
        // x = -11.63 (3.03 m beyond the 17.2 m nave rectangle; plan §1 said
        // ~2.5). The flat apse collision wall leaves the fan uncollided —
        // hence the tolerance. Composite: 7 collision pieces (this frame's
        // offsets — chapel is placed at yaw 0, so these equal chapter.ron's
        // world offsets directly).
        "chapel": (
            size: (20.03, 8.2),
            tolerance: 3.05,
            members: [
                ( prefab: "chapel_wall_side", offsets: [(0.0, 3.8), (0.0, -3.8)] ),
                ( prefab: "chapel_wall_apse", offsets: [(-8.3, 0.0)] ),
                ( prefab: "chapel_door_jamb", offsets: [(8.3, 2.5), (8.3, -2.5)] ),
                ( prefab: "chapel_lintel", offsets: [(8.3, 0.0)] ),
                ( prefab: "chapel_roof", offsets: [(-4.0, 0.0)] ),
            ],
        ),
        // Round basin r = 1.25; square collision box faces sit 0.10 in,
        // corners 0.31 out (plan §5 accepted approximation).
        "well_basin": ( size: (2.5, 2.5), tolerance: 0.31 ),
        // reja_set is deliberately absent: not placed in v1 (plan §7.3),
        // three loose grilles with no footprint contract.
    },
)
