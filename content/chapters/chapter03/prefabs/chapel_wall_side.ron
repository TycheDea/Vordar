// Invisible collision shell for one chapel nave side wall (kit model, full
// 16.6 m built length). The hitbox keeps the spawn-centred convention, so
// spawning at y=0 puts its top at 3.75 m — well above the player band the
// narrowphase cares about, and far short of the visual's 7.5 m springline.
// The visual is the always-rendered chapel zone prop, so no ShapeGroup.
(
    components: {
        "Transform": (),
        "Hitbox":    (shape: Aabb(half_extents: (8.3, 3.75, 0.3))),
        "Solid":     (),
        "Anchored":  (),
    },
)
