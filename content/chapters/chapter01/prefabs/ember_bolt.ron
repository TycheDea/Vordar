// Ember bolt — the cinder imp's spit: a slow, fat, very visible orange
// ember. Built to be sidestepped; getting hit is a choice.
(
    components: {
        "Transform":   (scale: (0.24, 0.24, 0.24)),
        "Velocity":    (),
        "RenderShape": (shape: Sphere, color: (2.5, 1.1, 0.25)), // >1 = HDR emissive (VQ-C3), threat orange (VQ-A4)
        "Hitbox":      (shape: Sphere(radius: 0.2)),
        "VfxTrail":    (color: (1.8, 0.8, 0.2), rate: 45.0, cell: 2, stretch: 1.0,
                        impact: Some((count: 10, speed: 2.8, size: 0.12, color: (2.5, 1.1, 0.25), cell: 3, blend: Alpha, ttl: (0.5, 0.9)))),
    },
)
