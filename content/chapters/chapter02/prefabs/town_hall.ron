// Town hall — the plaza's anchor building: timber-framed hall with a dark
// gabled roof and a warm door. Anchored: players collide with it, it never
// budges. No Health — indestructible by construction.
(
    components: {
        "Transform":  (),
        "ShapeGroup": (shapes: [
            // Walls
            (shape: Cube, offset: (0.0, 1.2, 0.0),  scale: (6.0, 2.4, 4.0),  color: (0.52, 0.44, 0.34)),
            // Timber trim band
            (shape: Cube, offset: (0.0, 2.35, 0.0), scale: (6.15, 0.2, 4.15), color: (0.30, 0.22, 0.16)),
            // Roof (two stacked slabs fake the gable at this zoom)
            (shape: Cube, offset: (0.0, 2.75, 0.0), scale: (6.6, 0.5, 4.6),  color: (0.28, 0.16, 0.12)),
            (shape: Cube, offset: (0.0, 3.25, 0.0), scale: (4.4, 0.5, 3.0),  color: (0.24, 0.13, 0.10)),
            // Door, facing the plaza (-X)
            (shape: Cube, offset: (-3.01, 0.8, 0.0), scale: (0.1, 1.6, 1.1), color: (0.36, 0.24, 0.14)),
        ]),
        "Hitbox":     (shape: Aabb(half_extents: (3.0, 1.2, 2.0))),
        "Solid":      (),
        "Anchored":   (),
    },
)
